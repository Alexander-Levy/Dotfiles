{
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Levy's Waybar Config
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
    "layer": "top",         // Waybar at top layer
    "position": "top",      // Waybar position (top|bottom|left|right)
    "spacing": 4,           // Gaps between modules (value in px)
    "height": 36,           // Waybar height (remove for auto height)

// Margins
    "margin-top":    0,
    "margin-left":   5,
    "margin-right":  5,
    "margin-bottom": 0,
    
// Modules 
    "modules-left":   ["group/island"],
    "modules-center": ["power-profiles-daemon"],
    "modules-right":  ["group/status"],

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Left side modules
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Workspace Module
    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "format-icons": {
            "active": "",
            "default": "",
            "empty": ""
        },
        "icon-size": 1,
        "sort-by-number": true,
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": []
        }
    },
// Network 
    "network": {
        "interval": 2,
        "format-wifi": "  ",
        "format-ethernet": " 󰈁",
        "format-disconnected": " 󰖪 ",
        "format-disabled": " 󱚼 ",
        "tooltip-format": " NETWORK STATUS:\n Name:\t\t{essid} \n Upload Speed:\t\t{bandwidthUpBytes}\n Download Speed:\t{bandwidthDownBytes}\n Local IP:\t\t{ipaddr}",
        "tooltip-format-wifi": " NETWORK STATUS:\n Name:\t\t\t{essid}\n Signal Strength:\t{signalStrength}%\n Upload Speed:\t\t{bandwidthUpBytes}\n Download Speed:\t{bandwidthDownBytes}\n Frecuency:\t\t{frequency} GHz\n Local IP:\t\t{ipaddr}",
        "on-click": "kitty --title kitty-nmmgr -e wlctl"
    },
// Bluetooth
    "bluetooth": {
        "interval": 2,
        "format": "  ",
        "format-disabled": " 󰂲 ", 
        "format-connected": " ({num_connections}) ",
        "tooltip-format": " COMMUNICATION STATUS:\n Controller:\t{controller_alias}\n Status:\t{status}\n Devices:\t{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "kitty --title kitty-blmgr -e bluetui"
    },
// Microphone
    "pulseaudio#microphone": {
        "max-volume": 100,
        "format": "{format_source} ",
        "format-source": "",
        "format-source-muted": "",
        "tooltip-format": " SOUND SYSTEM:\n Volume: {volume}%\n Device: {desc}"
    },
// Battery 
    "battery": {
        "interval": 2,
        "tooltip": true,
        "states": {
            "good": 80,
            "warning": 50,
            "critical": 30
        },
        "format":          "{capacity}% {icon} ",
        "format-full":     "{icon} ",
        "format-charging": "{capacity}%   ",
        "format-icons": [" ", " ", " ", " ", " "],
        "tooltip-format": " BATTERY STATUS:\n Capacity:\t\t{capacity}%\n Power Draw:\t\t{power:0.2f} Watts\n Battery Health:\t{health}%\n Time:\t\t\t{timeTo}" 
    },
// Tray 
    "tray": {
        "icon-size": 22,
        "spacing": 8
    },
// Audio Visualizer
    "custom/media": {
      "exec": "~/.config/waybar/modules/media-animation.sh",
      "tooltip": false
    },

// Applet 
    "group/island": {
        "orientation": "horizontal",
        "modules": [
            "hyprland/workspaces",
            "network",
            "bluetooth",
            "pulseaudio#microphone",
            "battery",
            "tray",
            "custom/media"
        ]
    },

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Middle modules
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Power management setting
    "power-profiles-daemon": {
        "format": " {icon} ",
        "tooltip-format": " POWER STATE:\n Power profile:\t{profile}\n Driver:\t{driver}",
        "tooltip": true,
        "format-icons": {
            "default": "",
            "performance": "CASPER",
            "balanced": "BALTHASAR",
            "power-saver": "MELCHIOR"
        }
    },

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Rigth side modules
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Caps and NumLock Key Indicators
    "keyboard-state": {
        "device-path": "/dev/input/event4",
        "numlock":      true,
        "capslock":     false,
        "scrolllock":   false,
        "format": " {name} {icon} ",
        "format-icons": {
            "locked": "",
            "unlocked": ""
        }
    },
// Screen Brigthness settings 
    "backlight": {
        "tooltip": true,
        "format": "{icon} {percent}% ",
        "tooltip-format": " MAGI SCREEN:\n Brigthness: {percent}% {icon}",
        "format-icons": ["", "", "", "", "", "", "", "", ""]
    },
// Volume Indicator
    "pulseaudio": {
        "format": "{icon} {volume}% ",
        "format-muted": "󰖁 ",
        "format-icons": {
            "headphone": "󰋋",
            "headset": "󰋎",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "scroll-step": 5,
        "on-click": "kitty --title kitty-pwmgr -e wiremix",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "tooltip-format": "{desc}: {volume}%"
    },
// Clock
    "clock": {
        "format": "{:%I:%M %p} ",
        "format-alt": "{:%A %d %B %Y} ",
        "tooltip-format": "<big><span color='#00f69b'>Calendar</span></big>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode"          : "month",
            "mode-mon-col"  : 3,
            "on-scroll"     : 1,
            "format": {
                "days":       "<span color='#00f69b'><b>{}</b></span>",
                "weeks":      "<span color='#ad8ee6'><b>W{}</b></span>",
                "months":     "<span color='#0db9d7'><b>{}</b></span>",
                "weekdays":   "<span color='#ad8ee6'><b>{}</b></span>",
                "today":      "<span color='#ff602b'><b>{}</b></span>"
            }
        },
        "actions":  { "on-click-right": "mode" }
    },
// Device Hardware Status Modules  
    "group/status": {
        "orientation": "horizontal",
        "modules": [
            "keyboard-state",
            "backlight",
            "pulseaudio",
            "clock"
        ]
    }
}
